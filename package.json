{
  "name": "emergency-protocol-diagram",
  "private": true,
  "version": "0.1.0",
  "description": "Emergency protocol diagram full-stack monorepo with React client and Express API",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace @emergency-protocol-diagram/client",
    "dev:server": "npm run dev --workspace @emergency-protocol-diagram/server",
    "build": "npm run build --workspaces",
    "postbuild": "rm -rf dist && mkdir -p dist && cp -R apps/client/dist/. dist/",
    "build:client": "npm run build --workspace @emergency-protocol-diagram/client",
    "build:server": "npm run build --workspace @emergency-protocol-diagram/server",
    "lint": "npm run lint --workspaces",
    "lint:client": "npm run lint --workspace @emergency-protocol-diagram/client",
    "lint:server": "npm run lint --workspace @emergency-protocol-diagram/server",
    "test": "npm run test:clinical-schema && npm run test:client && npm run test:server",
    "test:clinical-schema": "node scripts/validate-clinical-review-schema.mjs",
    "test:client": "npm run test --workspace @emergency-protocol-diagram/client",
    "test:coverage": "npm run test:coverage:client && npm run test:coverage:production",
    "test:coverage:client": "npm run test:coverage --workspace @emergency-protocol-diagram/client",
    "test:coverage:production": "npm run test:coverage --workspace @emergency-protocol-diagram/server",
    "test:server": "npm run test --workspace @emergency-protocol-diagram/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
