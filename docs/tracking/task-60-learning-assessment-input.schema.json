{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bls-protocol.evyatarhazan.com/schemas/task-60-learning-assessment-input.schema.json",
  "title": "Task 60 learning assessment input from Task 58",
  "description": "Contract for building learning assessment and mastery feedback without treating digital completion as clinical competence or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_task_id",
    "map_version",
    "intended_use",
    "learner_data_mode",
    "assessment_items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_task_id": {
      "const": 58
    },
    "map_version": {
      "type": "string",
      "minLength": 1
    },
    "intended_use": {
      "const": "learning_only"
    },
    "learner_data_mode": {
      "enum": ["anonymous_practice", "pseudonymous_learning_record"],
      "description": "Patient data and live-event data are prohibited."
    },
    "assessment_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessmentItem"
      }
    }
  },
  "$defs": {
    "reviewStatus": {
      "enum": [
        "pending",
        "in_review",
        "changes_requested",
        "scope_blocked",
        "approved_for_stated_use",
        "rejected",
        "expired",
        "withdrawn"
      ]
    },
    "authorityStatus": {
      "enum": ["unknown", "unassigned", "nominated", "confirmed", "declined"]
    },
    "assessmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "scenario_id",
        "competency_id",
        "outcome_id",
        "assessment_domain",
        "prompt_type",
        "prompt",
        "expected_evidence",
        "performance_indicator",
        "critical_error_candidates",
        "scoring_mode",
        "review_status",
        "authority_status",
        "source_status",
        "clinical_claim_allowed",
        "certification_claim_allowed",
        "patient_data_allowed"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^A60-[0-9]{3,}$"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^SCN-(0[1-9]|1[0-7])$"
        },
        "competency_id": {
          "type": "string",
          "pattern": "^BLS-C(0[1-9]|10)$"
        },
        "outcome_id": {
          "type": "string",
          "pattern": "^LO-(0[1-9]|1[0-7])-[0-9]{2}$"
        },
        "assessment_domain": {
          "enum": ["knowledge", "decision_reasoning", "communication", "practical_skill"]
        },
        "prompt_type": {
          "enum": ["ordering", "branch_choice", "short_explanation", "handoff", "instructor_observation"]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected_evidence": {
          "type": "string",
          "minLength": 1
        },
        "performance_indicator": {
          "type": "string",
          "minLength": 1
        },
        "critical_error_candidates": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "scoring_mode": {
          "enum": ["unscored_feedback", "rubric_pending", "instructor_only"]
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus",
          "default": "pending"
        },
        "authority_status": {
          "$ref": "#/$defs/authorityStatus",
          "default": "unknown"
        },
        "source_status": {
          "enum": ["missing", "pending", "verified", "rejected"],
          "default": "pending"
        },
        "review_flags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true,
          "default": []
        },
        "clinical_claim_allowed": {
          "const": false
        },
        "certification_claim_allowed": {
          "const": false
        },
        "patient_data_allowed": {
          "const": false
        },
        "instructor_observation_required": {
          "type": "boolean",
          "default": false
        },
        "review_reference": {
          "type": ["string", "null"],
          "default": null
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment_domain": {"const": "practical_skill"}
            },
            "required": ["assessment_domain"]
          },
          "then": {
            "required": ["instructor_observation_required"],
            "properties": {
              "prompt_type": {"const": "instructor_observation"},
              "scoring_mode": {"const": "instructor_only"},
              "instructor_observation_required": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {"const": "approved_for_stated_use"}
            },
            "required": ["review_status"]
          },
          "then": {
            "required": ["review_reference"],
            "properties": {
              "authority_status": {"const": "confirmed"},
              "source_status": {"const": "verified"},
              "review_reference": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
