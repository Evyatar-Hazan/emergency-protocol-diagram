    "test": "vitest run",
    "test:reference-scenarios": "vitest run src/protocols/referenceScenarios.test.ts --configLoader=runner",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "i18next": "^25.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.1",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
