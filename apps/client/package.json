{
  "name": "@emergency-protocol-diagram/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/generate-source-provenance-runtime.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node ../../scripts/check-offline-css-budget.mjs",
    "lint": "eslint .",
