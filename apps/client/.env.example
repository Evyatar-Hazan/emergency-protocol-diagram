# Frontend Environment Variables

# API Base URL. Keep this same-origin for Cloudflare Pages + D1 parity.
VITE_API_URL=/api

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Local synthetic instructor lab. Keep false for normal and production builds.
VITE_ENABLE_SYNTHETIC_INSTRUCTOR_TOOLS=false

# App Name
VITE_APP_NAME=Emergency Protocol Diagram

# Local-only content workflow. Keep disabled in production builds.
VITE_ENABLE_CONTENT_EDITOR=false
